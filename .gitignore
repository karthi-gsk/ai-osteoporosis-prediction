# ==============================================================================
# AI Osteoporosis Prediction System — Production .gitignore
# ==============================================================================

# ── Datasets & Medical Imagery (Strict Privacy & Size Limit) ──────────────────
dataset/
data/
*.JPEG
*.jpeg
*.bmp
*.tiff
*.zip
*.tar
*.tar.gz
*.gz
dataset/**

# ── Generated Reports & Documents ─────────────────────────────────────────────
*.pdf
reports/*.pdf
reports/**/*.pdf

# Allow frontend static assets and documentation report previews
!frontend/src/assets/**
!frontend/public/**
!reports/pdf_page_*.png

# ── Heavy Model Checkpoints (> 100 MB GitHub Push Limit) ─────────────────────
# Note: Frozen ResNet18 checkpoint is ~134 MB. Excluded from normal git history.
# Use Git LFS (see .gitattributes) or run python scripts/download_checkpoint.py
*.pth
*.pt
*.onnx
*.h5
*.ckpt
models/checkpoints/**/*.pth
models/checkpoints/**/*.pt

# ── Python Virtual Environments & Packages ───────────────────────────────────
venv/
.venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ── Python Bytecode & Caches ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ── Node.js & Frontend Builds ────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Local Secrets, Environment Variables & API Keys ──────────────────────────
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
backend/.env
*.pem
*.key
*.cert

# ── OS & IDE Temporary Artifacts ─────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~
*.log
logs/
