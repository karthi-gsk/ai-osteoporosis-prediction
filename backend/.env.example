# Backend Environment Configuration
HOST=0.0.0.0
PORT=8000
ENV=production

# Comma-separated list of allowed CORS origins in production
# Example: https://osteo-cnn.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=https://your-frontend-deployment.vercel.app,http://localhost:5173

# Optional path override for frozen model checkpoint
MODEL_CHECKPOINT_PATH=models/checkpoints/resnet18/best_model.pth

# Direct download URL for checkpoint if not packaged into Docker image
# CHECKPOINT_DOWNLOAD_URL=https://github.com/<USER>/<REPO>/releases/download/v1.0.0/best_model.pth
